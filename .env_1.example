# Copy this file to ".env" and enter your bot token.
# You find the token in the Discord Developer Portal under "Bot" -> "Reset Token".
DISCORD_TOKEN=your_token_here

# Roles allowed to use the bot's slash commands (comma-separated role IDs).
# Admins and the server owner can always use them.
BOT_ALLOWED_ROLE_IDS=

# Optional: ID of your server. Slash commands then appear immediately.
# Without it they can take up to an hour to show up.
GUILD_ID=

# Optional: ID of the channel where new members are greeted.
# Leave empty to use the server's system channel.
WELCOME_CHANNEL_ID=

# Ban requests (/banreq)
# Role ID of the members who may request bans
BANREQ_ROLE_ID=
# Channel ID where ban requests are posted for approval
BAN_REVIEW_CHANNEL_ID=

# Ticket panel (/ticketpanel)
# One category per ticket type (Discord category IDs)
TICKET_CATEGORY_SPAWNER_SELL_ID=
TICKET_CATEGORY_SPAWNER_BUY_ID=
TICKET_CATEGORY_SUPPORT_ID=
TICKET_CATEGORY_MOD_PURCHASE_ID=
TICKET_CATEGORY_GIVEAWAY_CLAIM_ID=
TICKET_CATEGORY_GIVEAWAY_SPONSOR_ID=
# Support: farm and general support each get their own category
TICKET_CATEGORY_FARM_SUPPORT_ID=
TICKET_CATEGORY_GENERAL_SUPPORT_ID=
# Fallback category for any type above that is left empty (optional)
TICKET_CATEGORY_ID=
# Role ID of staff who can see all tickets
SUPPORT_ROLE_ID=

# Staff applications (/applypanel)
# Channel ID where applications are posted for review
APPLICATION_REVIEW_CHANNEL_ID=
# Role ID given to accepted applicants
STAFF_ROLE_ID=

# Logs
# Channel where mod actions (bans, unbans, ban requests) are posted
MOD_LOG_CHANNEL_ID=
# Channel where ticket transcripts are posted when a ticket closes
TRANSCRIPT_CHANNEL_ID=

# AI assistant (automatic answers in tickets and /ask)
# Key from console.anthropic.com. Leave empty to turn the assistant off.
ANTHROPIC_API_KEY=
# Optional: model to use
AI_MODEL=claude-haiku-5-5
